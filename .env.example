NODE_ENV=development
# --- Copy to .env for local development. NEVER commit real values. ---
# staging/production: inject these from a secret manager (AWS Secrets Manager / SSM, GCP Secret Manager, etc.)

APP_ENV=local                      # local | test | staging | production
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/evidence_trust
DATABASE_POOL_MAX=20
DATABASE_SSL=false                 # true in staging/production
CORS_ORIGINS=http://localhost:5173 # REQUIRED in staging/production (comma separated)
PUBLIC_WEB_URL=http://localhost:5173
SESSION_TTL_HOURS=168
RATE_LIMIT_MAX=300
TRUST_PROXY=false                  # true behind a load balancer
METRICS_TOKEN=                     # REQUIRED in production (Bearer token for /metrics)

PLATFORM_FEE_BPS=0
SUPPORTED_CURRENCIES=usd
REQUIRE_SELLER_KYC=false           # set true once a KYC provider adapter is live

# Payments - Stripe (Connect). Missing => payment endpoints return 503 provider_not_configured
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Evidence storage - S3 or compatible. AWS credentials via the standard provider chain (role / AWS_ACCESS_KEY_ID...)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
MAX_EVIDENCE_BYTES=524288000

# Email - Resend
RESEND_API_KEY=
EMAIL_FROM=

# SMS - Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
